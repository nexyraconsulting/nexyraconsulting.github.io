# NEXCut — /nexcut/ on nexyraconsulting.co.uk (Apache)
Options -Indexes
DirectoryIndex index.html

RewriteEngine On
# /nexcut and /nexcut/ open the overview
RewriteRule ^$ product/index.html [R=301,L]
# Short links (and the earlier flat URLs) → product pages
RewriteRule ^(customers|business|pricing|checkout)\.html$ product/$1.html [R=301,L]

# Never serve backend source, docs or secrets templates
RewriteRule ^(supabase|docs)(/|$) - [F,L]
<FilesMatch "^(\.env.*|README\.md)$">
  Require all denied
</FilesMatch>

# Caching: HTML always revalidates; static assets cached for a week
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
