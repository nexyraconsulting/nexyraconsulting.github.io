# ─────────────────────────────────────────────────────────────────────────────
# NEXTime — server-side environment template.
# Copy to supabase/.env (never commit it) and load with:
#   supabase secrets set --env-file supabase/.env
# Browser-side (public) values live in public/config/app-config.js instead.
# See CONFIGURATION_CHECKLIST.md for where each value comes from.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase CLI (your machine / CI only, not a function secret) ── REQUIRED
SUPABASE_ACCESS_TOKEN=            # supabase.com → Account → Access tokens
SUPABASE_PROJECT_REF=             # e.g. abcdefghijklmnopqrst
SUPABASE_DB_PASSWORD=             # set when the project is created
# Direct Postgres connection (psql, backups, BI tools). Supabase → Project settings → Database
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Provided automatically inside Supabase Edge Functions (do NOT set with secrets set) ──
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# ── Application ── REQUIRED
APP_ORIGIN=https://app.example.com           # exact origin of public/, no trailing slash. Used for CORS and redirects.

# ── GoCardless (Direct Debit) ── REQUIRED if Direct Debit is offered
GOCARDLESS_ENV=sandbox                       # sandbox | live
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=

# ── Stripe (card, Apple Pay, Google Pay, invoices) ── REQUIRED if cards or invoices are offered
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE       # also put in public/config/app-config.js
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_AUTOMATIC_TAX=false                   # OPTIONAL: true to let Stripe Tax calculate VAT

# ── Billing ── OPTIONAL
VAT_RATE=0.2                                 # added to GoCardless amounts (Stripe uses its own tax settings)

# ── Transactional email (trial reminders, invites to existing users) ── REQUIRED for reminders
RESEND_API_KEY=
EMAIL_FROM="NEXTime <no-reply@example.com>"

# ── Scheduled tasks ── REQUIRED
CRON_SECRET=                                 # long random string; same value stored in Vault (see DATABASE_SETUP.md)
