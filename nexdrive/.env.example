# NexDrive API environment — copy to .env and fill in. Never commit .env.
# See docs/environment.md for descriptions.

NODE_ENV=development
PORT=8080
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080/v1
CORS_ORIGINS=http://localhost:3000
TZ=Europe/London

# Local docker-compose database (choose your own values)
POSTGRES_USER=nexdrive
POSTGRES_PASSWORD=
POSTGRES_DB=nexdrive
DATABASE_URL=postgres://nexdrive:<POSTGRES_PASSWORD>@localhost:5432/nexdrive
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# openssl rand -base64 64
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d
# openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_PREVIOUS=
PASSWORD_HASH_MEMORY_KIB=19456

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_1M=
STRIPE_PRICE_12M=
STRIPE_PRICE_24M=
STRIPE_PRICE_36M=
TRIAL_DAYS=14

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=

EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=NexDrive <no-reply@example.co.uk>

STORAGE_BUCKET=
STORAGE_REGION=eu-west-2
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

PUSH_EXPO_ACCESS_TOKEN=

SENTRY_DSN=
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=100
REMINDER_DEFAULT_MINUTES=30
FEATURE_WHATSAPP=false

# Referral programme
REFERRAL_BASE_URL=https://app.nexdrive.co.uk/join
REFERRAL_REWARD_PERCENT=20
REFERRAL_FREE_MONTHS=1
REFERRAL_HOLD_DAYS=14
REFERRAL_VALIDATE_RATE_LIMIT=10
