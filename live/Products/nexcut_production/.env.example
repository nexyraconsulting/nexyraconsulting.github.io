# ─── NEXCut billing — server-side secrets (Supabase Edge Function secrets) ───
# Set with:  supabase secrets set --env-file .env
# NEVER commit real values. NEVER put any of these in js/config.js.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me                 # service role: Edge Functions only

# Stripe (Dashboard → Developers → API keys). Use sk_test_… until launch.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me               # from the webhook endpoint for /functions/v1/stripe-webhook

# Website origins allowed to call the functions and to be used as Checkout return URLs (comma-separated)
ALLOWED_ORIGINS=https://nexyraconsulting.co.uk,https://www.nexyraconsulting.co.uk
BILLING_PORTAL_RETURN_URL=https://nexyraconsulting.co.uk/nexcut/product/business.html

# Email (Postmark) — transactional billing emails
POSTMARK_SERVER_TOKEN=replace-me
EMAIL_FROM=NEXCut <billing@nexcut.co.uk>
CRON_SECRET=replace-with-a-long-random-string        # protects send-notifications

# App stores (Route A). Not needed for the website. store-sync stays non-functional until set.
APPLE_BUNDLE_ID=uk.co.nexcut.business
APPLE_APP_ID=replace-me
APPLE_ISSUER_ID=replace-me
APPLE_KEY_ID=replace-me
APPLE_PRIVATE_KEY_P8="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
GOOGLE_PLAY_PACKAGE_NAME=uk.co.nexcut.business
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","replace":"me"}

# ─── Public values (go in js/config.js, safe to publish) ───
# supabaseUrl        = SUPABASE_URL
# supabaseAnonKey    = Dashboard → Settings → API → anon public key
# appStore*/playStore* listing URLs, termsUrl
